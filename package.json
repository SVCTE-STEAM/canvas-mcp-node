{
  "name": "canvas-mcp-svcte",
  "version": "1.2.0",
  "description": "Teacher-only Canvas LMS MCP server (Node + TypeScript) with FERPA pseudonyms, packaged as a one-click .mcpb. Based on awesome-town/canvas-mcp-node.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "canvas-mcp-svcte": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:manifest": "mcpb validate manifest.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.3",
    "axios": "^1.6.0",
    "dotenv": "^16.4.0",
    "tsx": "^4.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
